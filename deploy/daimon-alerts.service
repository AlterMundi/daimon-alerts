[Unit]
Description=Durable Daimon Alerts incident service
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/daimon-alerts/current/daimon-alerts serve %h/.config/daimon-alerts/service.json
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
MemoryMax=128M
TasksMax=32
LimitNOFILE=128
TimeoutStopSec=10

[Install]
WantedBy=default.target
